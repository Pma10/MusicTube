# Optional: your own/licensed audio library resolver.
# Expected GET query: provider, songId, title, artist
# Expected JSON: {"url":"https://cdn.example.com/song.mp3","filename":"song.mp3"}
MUSICTUBE_AUDIO_RESOLVER_URL=

# Optional: official YouTube Data API v3 key for YouTube Music video search.
# Enable YouTube Data API v3 in Google Cloud Console and restrict this key to that API.
YOUTUBE_API_KEY=

# Optional: override automatic Remotion worker selection (1-16).
# Leave empty to auto-scale from the machine's available CPU threads.
MUSICTUBE_RENDER_CONCURRENCY=

# Optional encoder override: auto | qsv | nvenc | x264
# Windows auto order: NVIDIA NVENC -> Intel Quick Sync -> CPU x264.
# macOS uses VideoToolbox automatically.
MUSICTUBE_RENDER_ENCODER=auto

# Optional custom directory containing ffmpeg/ffprobe/remotion binaries.
# Windows Intel Quick Sync setup normally creates .musictube/ffmpeg/bin automatically.
MUSICTUBE_FFMPEG_BIN_DIR=

# Set to 1 to skip the one-time Windows Quick Sync FFmpeg setup.
MUSICTUBE_SKIP_ACCEL_SETUP=0
