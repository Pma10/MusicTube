# Optional: your own/licensed audio library resolver.
# Expected GET query: provider, songId, title, artist
# Expected JSON: {"url":"https://cdn.example.com/song.mp3","filename":"song.mp3"}
MUSICTUBE_AUDIO_RESOLVER_URL=

# Optional: override automatic Remotion worker selection (1-16).
# Leave empty to auto-scale from the machine's available CPU threads.
MUSICTUBE_RENDER_CONCURRENCY=
